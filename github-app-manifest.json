{
  "name": "Witness Reviewer",
  "url": "https://github.com/witness-reviewer/witness",
  "description": "An AI code reviewer that only reports bugs it can prove with a failing test.",
  "hook_attributes": {
    "url": "https://witness.example.com/webhooks/github",
    "active": true
  },
  "redirect_url": "http://localhost:3555/callback",
  "public": false,
  "default_permissions": {
    "checks": "write",
    "contents": "read",
    "metadata": "read",
    "pull_requests": "write"
  },
  "default_events": ["pull_request"]
}
